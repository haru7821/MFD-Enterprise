{
  "name": "mfd-enterprise",
  "version": "0.1.0",
  "private": true,
  "description": "MFD-E — AI Medical Facility Design Platform",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @mfd/web dev",
    "build": "pnpm --filter @mfd/web build",
    "preview": "pnpm --filter @mfd/web preview",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "MFD_PERF=1 playwright test --workers=1 --timeout=240000",
    "test:e2e:ui": "playwright test --ui",
    "bench": "pnpm --filter @mfd/rule-engine bench",
    "lint": "eslint .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist **/*.tsbuildinfo",
    "knowledge:build": "vite-node scripts/build-knowledge.ts",
    "dataset:ingest": "vite-node scripts/ingest-dataset.ts",
    "knowledge:extract": "vite-node scripts/extract-observations.ts",
    "verify:drawing": "vite-node scripts/verify-drawing.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
