{
  "id": "dialysis_installation",
  "version": "0.1.0",
  "title": {
    "ko": "투석실 설치 순서",
    "en": "Dialysis Unit Installation Sequence"
  },
  "checklistSet": {
    "id": "dialysis_installation",
    "version": "0.1.0"
  },
  "authority": {
    "decidedBy": "developer",
    "status": "planning",
    "note": "Stage names, order and dependencies are ordinary construction sequencing: a loop is pressure tested before anything is connected to it, power is energised before commissioning, and the floor is finished before anything is anchored to it. They are stated here as data so a customer whose site sequences differently edits a file rather than the solver. NONE of it is a manufacturer instruction, and nothing here is verified: every entry carries status 'planning' and the planner passes that through. Labour rates and crew sizes are null because nobody has supplied any; see notes on each stage.",
    "openQuestion": "B-7"
  },
  "rateAuthority": {
    "decision": "B-7",
    "note": "Owner decision B-7: do not estimate manpower or installation duration. Every value must come from a referenced installation standard, and planning calculations may use only sourced installation rates. Duration = hoursFixed + (hoursPerStation x stationCount). Manpower = minimumPersons, recommendedPersons. If any required rate is missing, both are Unknown and the report states 'Planning rate data not available.' rather than a number. Never interpolate, never estimate, never infer.",
    "howToSupply": "Add one entry per stage to installationRates below. EVERY field is required: id, stage, hoursFixed, hoursPerStation, minimumPersons, recommendedPersons, source. A rate missing any field is rejected at load — a partial rate is not a rate, and evaluating half the formula would be interpolation. 'source' must name the published standard, its revision and its section; it is printed beside every figure the rate produces.",
    "noCodeChanges": "Supplying rates requires editing this file only. The planner reads installationRates by stage id, computes the formula above, and attaches the formula, the input values, the rate id and the citation to every figure it produces."
  },
